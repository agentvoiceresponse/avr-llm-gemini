PORT=6052
# HOST=0.0.0.0

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=300
GEMINI_THINKING_LEVEL=minimal
# Context cache for the prompt and tool declarations, TTL in seconds (0 = off)
GEMINI_CACHE_TTL_SECONDS=0
# Google Search grounding for questions outside the prompt (adds ~2 s on those turns)
GEMINI_WEB_SEARCH=false

# A prompt file (mounted into the container) and/or an inline prompt (appended to the file when both are set)
# SYSTEM_PROMPT_FILE=/usr/src/app/instructions.txt
SYSTEM_PROMPT="You are a helpful assistant."
# Time zone of the current date/time given to the model ("tomorrow" -> real date)
CALL_TIMEZONE=UTC

# avr-ami: caller ID lookup, avr_transfer and avr_hangup
AMI_URL=http://127.0.0.1:6006

# Optional
# DISABLED_TOOLS=avr_transfer
# SUPPORT_EMAIL=support@example.com
# AVR_HOOKS_PATH=/usr/src/app/hooks
# BOT_NAME=gemini_llm
